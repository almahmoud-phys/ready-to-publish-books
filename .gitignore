# Research workspace (ADR-010): local data — NEVER committed.
# Recreate on any machine with: ./tooling/scripts/research-init.sh
.kdp-research/

# Codanna code index — settings.toml is config (committed); the index is regenerable data.
.codanna/*
!.codanna/settings.toml
.fastembed_cache/

# Harness view: .claude/skills is a committed symlink to .agents/skills (the source of
# truth). Everything else Claude Code drops here is per-machine session state.
.claude/*
!.claude/skills

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
